# ---------------------------------------------------------------
# SocialsForce - variables de entorno de ejemplo
# Copia este archivo a .env y rellena los valores reales.
# ---------------------------------------------------------------

# Entorno y puerto
NODE_ENV=production
PORT=3000

# Acceso al panel admin (/admin)
# Si no se definen, se usan los valores por defecto del código.
ADMIN_USERNAME=kenzo
ADMIN_PASSWORD=juegoscuenta
# Secreto para firmar los tokens JWT del admin.
JWT_SECRET=change-me-to-a-long-random-string

# Datos legales (páginas legales: about, privacy, terms...)
LEGAL_OWNER=[OWNER NAME OR COMPANY]
LEGAL_TAX_ID=[NIF/CIF]
LEGAL_ADDRESS=[POSTAL ADDRESS, SPAIN]
LEGAL_EMAIL=[CONTACT EMAIL]
LEGAL_REGISTRY=
LEGAL_UPDATED=September 29, 2026

# Nota sobre la base de datos:
# db.js hoy tiene el host/usuario/contraseña hardcodeados y NO lee estas
# variables. Si en el futuro quieres parametrizarla, hay que cambiar db.js
# para que use process.env.DB_*.
# DB_HOST=localhost
# DB_USER=u256818095_admin
# DB_PASSWORD=
# DB_NAME=u256818095_socialsforce
