<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/logo.png" type="image/png">
    <%- include("partials/seo") %>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<%- include("partials/analytics") %>
<body>

    <%- include("partials/header") %>

    <%
      const userProv = (typeof detectedProvince !== "undefined" && detectedProvince)
        ? detectedProvince
        : { slug: "madrid", nombre: "Madrid" };
    %>

    <main id="categories-page">
        <section class="listing-page-section">
            <div class="content-container">

                <div class="listing-page-header">
                    <span class="listing-page-label">Zonas · PidePrecio.es</span>
                    <h1 class="listing-page-title">Selecciona tu Provincia o Zona</h1>
                    <p class="listing-page-description">
                        Tu zona detectada actualmente es <strong><%= userProv.nombre %></strong>. Puedes detectar tu ubicación por GPS, escribir tu Código Postal o elegir tu provincia para ver las secciones y páginas relevantes de tu área.
                    </p>

                    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:18px;max-width:620px;">
                        <button
                            type="button"
                            data-pp-detect-gps
                            style="background:#171717;color:#fff;border:0;border-radius:6px;padding:11px 16px;font-size:13.5px;font-weight:600;cursor:pointer;"
                        >
                            📍 Detectar mi ubicación exacta por GPS
                        </button>
                        <form action="/search" method="GET" style="display:flex;gap:8px;flex:1;min-width:240px;">
                            <input
                                type="text"
                                name="provincia"
                                placeholder="Código Postal (ej. 28001, 46001) o ciudad..."
                                style="flex:1;padding:10px 12px;border:1px solid #dcdcdc;border-radius:6px;font-size:13.5px;"
                            >
                            <button type="submit" style="background:#f4f4f4;border:1px solid #dcdcdc;border-radius:6px;padding:10px 16px;font-size:13.5px;font-weight:600;cursor:pointer;">Entrar</button>
                        </form>
                    </div>
                </div>

                <div class="content-sidebar-layout">
                    <div class="main-content">
                        <div class="sidebar-pills" style="gap:10px;">
                            <% (allLocations || []).forEach(function(loc) { %>
                                <a
                                    href="/<%= loc.slug %>"
                                    class="sidebar-pill"
                                    style="padding:10px 14px;font-size:14px;<%= loc.slug === userProv.slug ? 'background:#171717;color:#fff;' : '' %>"
                                >
                                    📍 <%= loc.nombre %>
                                </a>
                            <% }) %>
                        </div>
                    </div>

                    <aside class="sidebar" aria-label="Más artículos">
                        <%- include("partials/sidebar", { sidebarData: typeof sidebarData !== "undefined" ? sidebarData : null }) %>
                    </aside>
                </div>

            </div>
        </section>
    </main>

    <%- include("partials/footer") %>
    <script src="/js/main.js"></script>
</body>
</html>
