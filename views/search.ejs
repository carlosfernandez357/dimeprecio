<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/images/logo.png" type="image/png">
    <%- include('partials/seo') %>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/home-extras.css">
    <link rel="stylesheet" href="/css/sidebar.css">
</head>
<body>
<%- include("partials/header") %>

<% const activeProv = typeof currentProvince !== 'undefined' && currentProvince ? currentProvince : (typeof detectedProvince !== 'undefined' ? detectedProvince : { slug: 'madrid', nombre: 'Madrid' }); %>
<% const queryStr = typeof q !== 'undefined' ? q : ''; %>
<% const results = typeof posts !== 'undefined' && posts ? posts : []; %>
<% const fallbackMode = typeof isFallback !== 'undefined' && isFallback; %>
<% const secFilter = typeof sectorFilter !== 'undefined' ? sectorFilter : ''; %>
<% const provFilterVal = typeof provFilter !== 'undefined' && provFilter ? provFilter : activeProv.slug; %>

<main class="search-page">
    <div class="content-container content-sidebar-layout">
        <div class="main-content">
            <span class="listing-page-label">
                Zona activa: <a href="/<%= activeProv.slug %>" style="color:inherit;text-decoration:underline;"><%= activeProv.nombre %></a> · <a href="/provincias" style="color:inherit;text-decoration:underline;">Cambiar provincia</a>
            </span>
            <h1 style="margin-top:6px;font-size:26px;font-weight:800;color:#0f172a;letter-spacing:-0.5px;">
                <%= queryStr ? 'Resultados para "' + queryStr + '" en ' + activeProv.nombre : 'Buscador de Servicios y Precios en ' + activeProv.nombre %>
            </h1>

            <!-- BARRA DE BÚSQUEDA Y FILTRADO HÍBRIDO -->
            <form action="/search" method="GET" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:16px;margin:18px 0 24px;box-shadow:0 2px 6px rgba(0,0,0,0.03);">
                <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
                    <div style="flex:2;min-width:240px;position:relative;">
                        <input
                            type="text"
                            name="q"
                            value="<%= queryStr %>"
                            placeholder="Ej: cerrajero urgente, fugas de agua, pintar piso, goteras..."
                            style="width:100%;box-sizing:border-box;padding:11px 14px;border:1px solid #cbd5e1;border-radius:8px;font-size:14.5px;outline:none;"
                        >
                    </div>
                    <div style="flex:1;min-width:160px;">
                        <select name="provincia" style="width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13.5px;font-weight:600;color:#1e293b;background:#ffffff;cursor:pointer;">
                            <% if (typeof allLocations !== 'undefined' && allLocations && allLocations.length) { %>
                                <% allLocations.forEach(loc => { %>
                                    <option value="<%= loc.slug %>" <%= (activeProv.slug === loc.slug) ? 'selected' : '' %>>📍 <%= loc.nombre %></option>
                                <% }) %>
                            <% } else { %>
                                <option value="<%= activeProv.slug %>" selected>📍 <%= activeProv.nombre %></option>
                            <% } %>
                        </select>
                    </div>
                    <div style="flex:1;min-width:180px;">
                        <select name="sector" style="width:100%;box-sizing:border-box;padding:11px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13.5px;font-weight:600;color:#1e293b;background:#ffffff;cursor:pointer;">
                            <option value="">🛠️ Todos los servicios</option>
                            <% if (typeof allSectors !== 'undefined' && allSectors && allSectors.length) { %>
                                <% allSectors.forEach(sec => { %>
                                    <option value="<%= sec.slug %>" <%= (secFilter === sec.slug) ? 'selected' : '' %>><%= sec.icono || '🛠️' %> <%= sec.nombre %></option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <button type="submit" style="padding:11px 22px;border:none;border-radius:8px;background:#0f172a;color:#fff;font-weight:700;font-size:14px;cursor:pointer;white-space:nowrap;transition:background 0.15s ease;">
                        🔍 Filtrar / Buscar
                    </button>
                </div>
            </form>

            <% if (fallbackMode && queryStr) { %>
            <!-- AVISO SUTIL DE BÚSQUEDA SUGERIDA / FALLBACK -->
            <div style="background:#f0fdf4;border:1px solid #bbf7d0;border-left:4px solid #10b981;border-radius:10px;padding:14px 18px;margin-bottom:24px;">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px;">
                    <span style="font-size:16px;">💡</span>
                    <strong style="font-size:14.5px;color:#0f172a;">
                        Sin coincidencias exactas para "<%= queryStr %>"
                    </strong>
                </div>
                <p style="margin:0;font-size:13px;color:#475569;line-height:1.5;">
                    No hemos encontrado una página con ese nombre exacto, pero te mostramos los <strong>servicios profesionales y guías oficiales más demandados en <%= activeProv.nombre %></strong> para que puedas pedir presupuesto o consultar tarifas orientativas.
                </p>
            </div>
            <% } %>

            <% if (typeof matchedSectors !== 'undefined' && matchedSectors && matchedSectors.length > 0) { %>
            <section style="margin-bottom:28px;">
                <div class="section-header" style="margin-bottom:12px;display:flex;align-items:baseline;justify-content:space-between;flex-wrap:wrap;gap:8px;">
                    <div>
                        <h2 class="section-title" style="font-size:17px;font-weight:800;color:#0f172a;">
                            <%= fallbackMode ? '1. Servicios recomendados en ' + activeProv.nombre : '1. Secciones y Oficios relacionados en ' + activeProv.nombre %>
                        </h2>
                        <span style="font-size:12.5px;color:#64748b;">Selecciona un servicio para comparar precios y pedir presupuesto oficial</span>
                    </div>
                    <a href="/<%= activeProv.slug %>" style="font-size:12.5px;color:#10b981;font-weight:700;text-decoration:none;">Ver todos en <%= activeProv.nombre %> →</a>
                </div>
                <div class="category-Mosaic-grid">
                    <% matchedSectors.slice(0, 6).forEach(sec => { %>
                    <a class="category-Mosaic-tile" href="/<%= activeProv.slug %>/<%= sec.slug %>">
                        <span class="category-Mosaic-name"><%= sec.icono || '🛠️' %> <%= sec.nombre %></span>
                        <span class="category-Mosaic-count">Zona <%= activeProv.nombre %> →</span>
                    </a>
                    <% }) %>
                </div>
            </section>
            <% } %>

            <div class="section-header" style="margin-bottom:14px;">
                <h2 class="section-title" style="font-size:17px;font-weight:800;color:#0f172a;">
                    <%= fallbackMode ? '2. Guías de precios más consultadas' : '2. Artículos y Guías Oficiales encontradas (' + results.length + ')' %>
                </h2>
            </div>

            <% if (results.length === 0) { %>
                <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:24px;text-align:center;">
                    <p style="margin:0 0 14px;color:#475569;font-size:14.5px;">No encontramos guías con ese filtro específico en <%= activeProv.nombre %>.</p>
                    <a href="/pedir-presupuesto" style="display:inline-block;background:#171717;color:#fff;padding:10px 18px;border-radius:6px;font-weight:700;text-decoration:none;font-size:13.5px;">
                        📋 Pedir Presupuesto General sin compromiso
                    </a>
                </div>
            <% } %>

            <div class="latest-posts-list">
                <% results.forEach(post => { %>
                <article class="horizontal-post-card">
                    <a href="/article/<%= post.slug %>" class="horizontal-post-link" data-rec-slot="search" data-rec-slug="<%= post.slug %>">
                        <img
                            src="<%= post.image || post.featured_image || 'https://images.unsplash.com/photo-1581578731548-c64695cc6952?w=800&q=80' %>"
                            alt="<%= post.title %>"
                            class="horizontal-post-image"
                        >
                        <div class="horizontal-post-content">
                            <span class="post-category">
                                <%= post.provincia_nombre || activeProv.nombre %> · <%= post.sector_nombre || post.category || 'Guía Oficial' %>
                            </span>
                            <h2 class="post-title"><%= post.title %></h2>
                            <p class="post-summary"><%= post.excerpt %></p>
                        </div>
                    </a>
                </article>
                <% }) %>
            </div>
        </div>

        <aside class="sidebar" aria-label="Más secciones y páginas">
            <%- include('partials/sidebar', { sidebarData: typeof sidebarData !== "undefined" ? sidebarData : null }) %>
        </aside>
    </div>
</main>

<%- include("partials/footer") %>
<script src="/js/main.js"></script>
</body>
</html>
