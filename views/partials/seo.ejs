<%
const SITE_URL = process.env.SITE_URL || "https://pideprecio.es";
const SITE_NAME = "PidePrecio.es · Artículos Especializados, Guías y Soluciones por Sectores y Provincias";

const seoType = (typeof pageType !== "undefined" && pageType === "article") ? "article" : "website";
const seoPost = (typeof post !== "undefined" && post) ? post : null;
const seoProv = (typeof currentProvince !== "undefined" && currentProvince) ? currentProvince : (typeof province !== "undefined" && province ? province : null);
const seoSec = (typeof currentSector !== "undefined" && currentSector) ? currentSector : (typeof sector !== "undefined" && sector ? sector : null);

const seoTitle = (typeof title !== "undefined" && title)
    ? title
    : "PidePrecio.es: Guías, Artículos y Soluciones por Sectores y Provincias en España";

const rawDescription = (typeof description !== "undefined" && description)
    ? String(description)
    : "Artículos especializados, guías prácticas y conexión directa por sectores y provincias en España. Encuentra tu solución y completa el formulario del sector.";
const cleanDescription = rawDescription.replace(/<[^>]*>/g, "").replace(/\s+/g, " ").trim();
const seoDescription = cleanDescription.length > 165
    ? cleanDescription.slice(0, 162).trim() + "..."
    : cleanDescription;

const seoCanonical = (typeof canonicalUrl !== "undefined" && canonicalUrl) ? canonicalUrl : SITE_URL + "/";

const absoluteUrl = (url) => {
    if (!url) return SITE_URL + "/images/logo.png";
    if (/^https?:\/\//i.test(url)) return url;
    return SITE_URL + (url.startsWith("/") ? url : "/" + url);
};
const seoImage = absoluteUrl((typeof ogImage !== "undefined" && ogImage) ? ogImage : null);

const toIso = (d) => {
    if (!d) return undefined;
    const date = new Date(d);
    return isNaN(date.getTime()) ? undefined : date.toISOString();
};

const safeJson = (obj) => JSON.stringify(obj).replace(/</g, "\\u003c");

const organization = {
    "@type": "Organization",
    "name": "PidePrecio.es",
    "url": SITE_URL,
    "logo": { "@type": "ImageObject", "url": SITE_URL + "/images/logo.png" }
};

let jsonLd = [];

if (typeof customSchemas !== "undefined" && Array.isArray(customSchemas) && customSchemas.length) {
    jsonLd = jsonLd.concat(customSchemas);
} else if (seoType === "article" && seoPost) {
    const published = toIso(seoPost.published_at || seoPost.created_at);
    const modified = toIso(seoPost.updated_at) || published;
    jsonLd.push({
        "@context": "https://schema.org",
        "@type": "Article",
        "mainEntityOfPage": { "@type": "WebPage", "@id": seoCanonical },
        "headline": String(seoPost.title || "").slice(0, 110),
        "description": seoDescription,
        "image": [seoImage],
        "datePublished": published,
        "dateModified": modified,
        "articleSection": seoPost.sector_nombre || seoPost.category_name || "Guías por Sector",
        "about": {
            "@type": "Service",
            "name": seoPost.sector_nombre || "Servicios Profesionales",
            "areaServed": {
                "@type": "AdministrativeArea",
                "name": seoPost.provincia_nombre || (seoProv && seoProv.nombre) || "España"
            }
        },
        "author": { "@type": "Organization", "name": "PidePrecio.es", "url": SITE_URL },
        "publisher": organization,
        "url": seoCanonical
    });
    const breadcrumbItems = [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": SITE_URL + "/" }
    ];
    if (seoProv) {
        breadcrumbItems.push({ "@type": "ListItem", "position": breadcrumbItems.length + 1, "name": seoProv.nombre, "item": SITE_URL + "/" + seoProv.slug });
    }
    if (seoProv && seoSec) {
        breadcrumbItems.push({ "@type": "ListItem", "position": breadcrumbItems.length + 1, "name": seoSec.nombre + " en " + seoProv.nombre, "item": SITE_URL + "/" + seoProv.slug + "/" + seoSec.slug });
    }
    breadcrumbItems.push({ "@type": "ListItem", "position": breadcrumbItems.length + 1, "name": String(seoPost.title || "").slice(0, 90), "item": seoCanonical });
    jsonLd.push({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": breadcrumbItems
    });
} else {
    jsonLd.push({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": SITE_NAME,
        "url": SITE_URL + "/",
        "publisher": organization,
        "potentialAction": {
            "@type": "SearchAction",
            "target": { "@type": "EntryPoint", "urlTemplate": SITE_URL + "/search?q={search_term_string}" },
            "query-input": "required name=search_term_string"
        }
    });
    if (seoProv) {
        const breadcrumbItems = [
            { "@type": "ListItem", "position": 1, "name": "Inicio", "item": SITE_URL + "/" },
            { "@type": "ListItem", "position": 2, "name": seoProv.nombre, "item": SITE_URL + "/" + seoProv.slug }
        ];
        if (seoSec) {
            breadcrumbItems.push({ "@type": "ListItem", "position": 3, "name": seoSec.nombre + " en " + seoProv.nombre, "item": SITE_URL + "/" + seoProv.slug + "/" + seoSec.slug });
        }
        jsonLd.push({
            "@context": "https://schema.org",
            "@type": "BreadcrumbList",
            "itemListElement": breadcrumbItems
        });
    }
}
%>
    <title><%= seoTitle %></title>
    <meta name="description" content="<%= seoDescription %>">
    <meta name="robots" content="<%= (typeof robots !== "undefined" && robots) ? robots : "index, follow, max-image-preview:large" %>">
    <meta name="theme-color" content="#171717">
    <link rel="canonical" href="<%= seoCanonical %>">
    <link rel="alternate" type="application/rss+xml" title="PidePrecio.es RSS" href="/feed.xml">
    <link rel="apple-touch-icon" href="<%= SITE_URL %>/images/logo.png">

    <!-- Open Graph -->
    <meta property="og:site_name" content="PidePrecio.es">
    <meta property="og:locale" content="es_ES">
    <meta property="og:type" content="<%= seoType %>">
    <meta property="og:title" content="<%= seoTitle %>">
    <meta property="og:description" content="<%= seoDescription %>">
    <meta property="og:url" content="<%= seoCanonical %>">
    <meta property="og:image" content="<%= seoImage %>">
    <meta property="og:image:alt" content="<%= seoTitle %>">

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= seoTitle %>">
    <meta name="twitter:description" content="<%= seoDescription %>">
    <meta name="twitter:image" content="<%= seoImage %>">

    <% jsonLd.forEach(schema => { %>
    <script type="application/ld+json"><%- safeJson(schema) %></script>
    <% }) %>
