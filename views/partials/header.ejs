<%
const headerLocations = (typeof allLocations !== "undefined" && Array.isArray(allLocations)) ? allLocations : [];
const headerSectors = (typeof allSectors !== "undefined" && Array.isArray(allSectors)) ? allSectors : [];
const userProv = (typeof detectedProvince !== "undefined" && detectedProvince)
    ? detectedProvince
    : { slug: "madrid", nombre: "Madrid", comunidad_autonoma: "Comunidad de Madrid", modificador_precio_regional: 1.15 };
const topNavSectors = headerSectors.slice(0, 12);
%>
<header id="site-header">
    <div class="header-container">

        <!-- LOGO ESTILO SOCIALSFORCE -->
        <a href="/" id="site-logo">
            PidePrecio<span style="color:#666;font-weight:500;">.es</span>
        </a>

        <!-- DETECTOR DE ZONA DISCRETO EN CABECERA -->
        <div class="categories-dropdown" style="margin-left:18px;">
            <button
                type="button"
                class="navigation-button"
                style="display:inline-flex;align-items:center;gap:6px;background:#f4f4f4;padding:6px 12px;border-radius:999px;font-size:13px;font-weight:600;color:#171717;"
                onclick="document.getElementById('ppZoneMenu').classList.toggle('active');event.stopPropagation();"
            >
                <span>📍</span>
                <span data-pp-prov-label><%= userProv.nombre %></span>
                <span class="dropdown-arrow">⌄</span>
            </button>

            <div id="ppZoneMenu" class="categories-menu" style="min-width:290px;padding:14px;left:0;" onclick="event.stopPropagation();">
                <div style="font-size:12px;font-weight:700;color:#171717;margin-bottom:8px;">
                    Tu zona actual: <span data-pp-prov-label><%= userProv.nombre %></span>
                </div>
                <button
                    type="button"
                    data-pp-detect-gps
                    style="width:100%;background:#171717;color:#fff;border:0;border-radius:6px;padding:8px 10px;font-size:12.5px;font-weight:600;cursor:pointer;margin-bottom:10px;"
                >
                    📍 Detectar mi ubicación exacta (GPS)
                </button>
                <form id="ppZoneQuickForm" style="display:flex;gap:6px;margin-bottom:10px;">
                    <input
                        id="ppZoneQuickInput"
                        type="text"
                        placeholder="Código Postal (ej. 28001) o ciudad..."
                        style="flex:1;padding:7px 9px;border:1px solid #dcdcdc;border-radius:6px;font-size:12.5px;"
                    >
                    <button type="submit" style="background:#f4f4f4;border:1px solid #dcdcdc;border-radius:6px;padding:7px 10px;font-size:12px;font-weight:600;cursor:pointer;">Ir</button>
                </form>
                <div style="font-size:11px;color:#777;text-transform:uppercase;font-weight:600;margin-bottom:6px;">Cambiar de zona</div>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:4px;">
                    <% ["madrid", "barcelona", "valencia", "sevilla", "zaragoza", "malaga", "murcia", "alicante", "vizcaya", "a-coruna"].forEach(function(slug) {
                        const loc = headerLocations.find(l => l.slug === slug);
                        if (loc) { %>
                        <a href="/<%= loc.slug %>" class="category-link" style="padding:6px 8px;font-size:13px;"><%= loc.nombre %></a>
                    <% } }); %>
                </div>
                <a href="/provincias" class="category-link" style="margin-top:6px;border-top:1px solid #eee;padding-top:8px;font-weight:600;font-size:12.5px;">
                    Ver todas las zonas →
                </a>
            </div>
        </div>

        <!-- NAVEGACIÓN PRINCIPAL ESTILO SOCIALSFORCE -->
        <nav id="main-navigation">
            <a href="/<%= userProv.slug %>" data-pp-prov-link class="navigation-link">
                En <span data-pp-prov-label><%= userProv.nombre %></span>
            </a>

            <!-- DROPDOWN SECCIONES / SECTORES -->
            <div class="categories-dropdown">
                <button
                    id="categories-button"
                    class="navigation-button"
                    type="button"
                    aria-expanded="false"
                >
                    Secciones
                    <span class="dropdown-arrow">⌄</span>
                </button>
                <div id="categories-menu" class="categories-menu" style="min-width:250px;">
                    <% topNavSectors.forEach(function(sec) { %>
                    <a href="/<%= userProv.slug %>/<%= sec.slug %>" class="category-link">
                        <%= sec.nombre %>
                    </a>
                    <% }) %>
                    <a href="/categories" class="category-link" style="border-top:1px solid #eee;margin-top:4px;padding-top:8px;font-weight:600;">
                        Todas las secciones →
                    </a>
                </div>
            </div>

            <a href="/for-you" class="navigation-link">Para Ti</a>
            <a href="/trending" class="navigation-link">Tendencias</a>
            <a href="/recent" class="navigation-link">Recientes</a>
            <a href="/provincias" class="navigation-link">Zonas</a>
        </nav>

        <!-- ACCIONES CABECERA ESTILO SOCIALSFORCE + BOTÓN GENERAL PEDIR PRESUPUESTO -->
        <div id="header-actions" style="display:flex;align-items:center;gap:10px;">
            <a
                href="/pedir-presupuesto"
                id="header-quote-btn"
                style="display:inline-flex;align-items:center;gap:6px;background:#171717;color:#ffffff;padding:8px 14px;border-radius:999px;font-size:13px;font-weight:700;text-decoration:none;white-space:nowrap;"
            >
                <span>📋</span>
                <span>Pedir Presupuesto</span>
            </a>
            <button
                id="search-button"
                class="icon-button"
                type="button"
                aria-label="Buscar"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="16.5" y1="16.5" x2="22" y2="22"></line>
                </svg>
            </button>

            <button
                id="mobile-menu-button"
                class="icon-button mobile-menu-button"
                type="button"
                aria-label="Menú"
            >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <line x1="3" y1="6" x2="21" y2="6"></line>
                    <line x1="3" y1="12" x2="21" y2="12"></line>
                    <line x1="3" y1="18" x2="21" y2="18"></line>
                </svg>
            </button>
        </div>

    </div>

    <!-- BUSCADOR DESPLEGABLE ESTILO SOCIALSFORCE -->
    <div id="search-container">
        <form id="search-form" action="/search" method="GET" style="position:relative;">
            <div class="search-input-wrapper">
                <svg class="search-input-icon" viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="11" cy="11" r="7"></circle>
                    <line x1="16.5" y1="16.5" x2="22" y2="22"></line>
                </svg>
                <input
                    id="search-input"
                    name="q"
                    type="search"
                    placeholder="Buscar en <%= userProv.nombre %> (ej. reformas pequeñas casa, bañera por ducha, fontanero, tejados)..."
                    autocomplete="off"
                >
                <button id="search-submit" type="submit">Buscar</button>
            </div>
            <div id="ppSearchDropdown" class="pp-search-dropdown" style="display:none;"></div>
        </form>
    </div>

    <!-- NAVEGACIÓN MÓVIL ESTILO SOCIALSFORCE -->
    <nav id="mobile-navigation">
        <a href="/" class="mobile-navigation-link">Inicio</a>
        <a href="/pedir-presupuesto" class="mobile-navigation-link" style="font-weight:800;color:#171717;">📋 Pedir Presupuesto General</a>
        <a href="/<%= userProv.slug %>" data-pp-prov-link class="mobile-navigation-link">📍 Tu Zona: <span data-pp-prov-label><%= userProv.nombre %></span></a>
        <a href="/for-you" class="mobile-navigation-link">Para Ti</a>
        <a href="/trending" class="mobile-navigation-link">Tendencias</a>
        <a href="/recent" class="mobile-navigation-link">Recientes</a>
        <a href="/categories" class="mobile-navigation-link">Secciones</a>
        <a href="/provincias" class="mobile-navigation-link">Cambiar Provincia</a>
    </nav>
</header>
<script>
document.addEventListener('click', function() {
    var zm = document.getElementById('ppZoneMenu');
    if (zm) zm.classList.remove('active');
});
</script>
