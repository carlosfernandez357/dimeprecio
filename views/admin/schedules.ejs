<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Programación Automática IA — DimePrecio.es' %></title>
  <link rel="stylesheet" href="/css/admin.css">
  <link rel="stylesheet" href="/css/rankrent.css">
</head>
<body>
  <%- include("partials/header") %>

  <div class="admin-layout">
    <%- include("partials/sidebar") %>

    <main class="admin-main">
    
    <div class="admin-page-header">
        <div>
            <h1>⏱ Cron & Programación Automática por Tendencias Google</h1>
            <p>Programa la creación automática de artículos basándose en las búsquedas reales y tendencias más calientes de Google en España para maximizar el tráfico SEO y AEO.</p>
        </div>
    </div>

    <div style="background:linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%); color:#fff; border-radius:12px; padding:18px 22px; margin-bottom:22px; display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:14px;">
        <div>
            <div style="font-size:15.5px; font-weight:800;">🌍 Nuevo: Recorrido Automático en Bucle por Todas las Ciudades × Servicios</div>
            <div style="font-size:13px; color:#cbd5e1; margin-top:3px;">
                Recorre las 52 ciudades y todos los servicios automáticamente buscando noticias recientes y curiosidades locales, con mapa de progreso, pausa/reanudación y control de faltantes.
            </div>
        </div>
        <a href="/admin/recorrido-ciudades" style="background:#22c55e; color:#fff; font-weight:700; font-size:13.5px; padding:10px 18px; border-radius:8px; text-decoration:none; white-space:nowrap;">
            Abrir Recorrido Ciudades × Servicios →
        </a>
    </div>

    <% const schedList = (typeof schedules !== "undefined" && Array.isArray(schedules)) ? schedules : []; %>
    <% const activeCount = schedList.filter(s => s.is_active).length; %>

    <div class="admin-stats-grid" style="margin-bottom:24px;">
        <div class="admin-stat-card">
            <span class="admin-stat-label">Estado del Cron</span>
            <strong class="admin-stat-value">
                <% if (activeCount > 0) { %>
                    <span class="index-status indexed"><span></span>Activo (<%= activeCount %> tareas)</span>
                <% } else { %>
                    <span class="index-status not-indexed"><span></span>Sin tareas activas</span>
                <% } %>
            </strong>
            <span class="admin-stat-description">
                <%= activeCount > 0 ? "Ejecutando ciclos automáticos en segundo plano" : "Configura tu primera tarea programada abajo" %>
            </span>
        </div>

        <div class="admin-stat-card">
            <span class="admin-stat-label">Motor de Contenido</span>
            <strong class="admin-stat-value" style="color:#2563eb;">🔥 Google Trends + AEO</strong>
            <span class="admin-stat-description">Detecta preguntas reales sin artículo y las cubre</span>
        </div>

        <div class="admin-stat-card">
            <span class="admin-stat-label">Tareas Programadas</span>
            <strong class="admin-stat-value"><%= schedList.length %></strong>
            <span class="admin-stat-description"><%= activeCount %> activas · <%= schedList.length - activeCount %> pausadas</span>
        </div>

        <div class="admin-stat-card">
            <span class="admin-stat-label">Teléfono Operador Integrado</span>
            <strong class="admin-stat-value" style="color:#16a34a; font-size:16px;">+34 622 15 87 03</strong>
            <span class="admin-stat-description">Incluido en cada artículo generado</span>
        </div>
    </div>

    <div class="admin-dashboard-grid">
        <!-- FORMULARIO DE NUEVA TAREA -->
        <section class="admin-card">
            <div class="admin-card-header">
                <div>
                    <h2>➕ Programar Nueva Generación por Tendencias</h2>
                    <p>Elige un sector y provincia. El cron buscará en Google qué preguntas y tarifas se están buscando y creará el artículo optimizado automáticamente.</p>
                </div>
            </div>

            <form action="/admin/schedules" method="POST">
                <div class="admin-form-group">
                    <label>Sector / Servicio Objetivo</label>
                    <select name="sector_slug" id="sector_slug" style="width:100%; padding:10px; border:1px solid #d1d5db; border-radius:6px;" required>
                        <% (allSectors || []).forEach(function(sec) { %>
                            <option value="<%= sec.slug %>"><%= sec.nombre %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="admin-form-group">
                    <label>Provincia Objetivo</label>
                    <select name="provincia_slug" id="provincia_slug" style="width:100%; padding:10px; border:1px solid #d1d5db; border-radius:6px;" required>
                        <% (allLocations || []).forEach(function(loc) { %>
                            <option value="<%= loc.slug %>" <%= loc.slug === 'madrid' ? 'selected' : '' %>><%= loc.nombre %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="admin-form-group">
                    <label>Frecuencia de Creación</label>
                    <select name="frequency" style="width:100%; padding:10px; border:1px solid #d1d5db; border-radius:6px;">
                        <option value="hourly">Cada 1 Hora (Alta frecuencia / Cobertura rápida)</option>
                        <option value="every_6h">Cada 6 Horas (4 artículos diarios)</option>
                        <option value="daily" selected>Diario (1 artículo al día)</option>
                        <option value="weekly">Semanal (1 artículo a la semana)</option>
                    </select>
                </div>

                <div class="admin-form-group" style="background:#eff6ff; padding:12px; border-radius:8px; border:1px solid #bfdbfe;">
                    <label style="display:flex; align-items:center; gap:8px; font-weight:700; color:#1e40af; cursor:pointer;">
                        <input type="checkbox" name="use_trends" value="1" checked>
                        🔥 Modo Tendencias Google (Auto-detecta en cada ciclo la consulta más buscada)
                    </label>
                    <small style="color:#3b82f6; display:block; margin-top:4px;">
                        Comprueba si el término ya está en la web. Si ya existe, salta al siguiente para no duplicar contenido y maximizar las palabras clave indexadas.
                    </small>
                </div>

                <div class="admin-form-group">
                    <label style="display:flex; align-items:center; gap:8px; cursor:pointer;">
                        <input type="checkbox" name="auto_publish" value="1" checked>
                        Publicar directamente en la web (Estado: Published)
                    </label>
                </div>

                <button type="submit" class="admin-primary-button" style="width:100%; background:#2563eb;">
                    💾 Guardar y Activar Programación
                </button>
            </form>
        </section>

        <!-- LISTADO DE TAREAS Y EJECUCIÓN MANUAL -->
        <section class="admin-card">
            <div class="admin-card-header">
                <div>
                    <h2>📋 Tareas Programadas Activas</h2>
                    <p>Gestiona los trabajos de creación y pruébalos al instante con un clic.</p>
                </div>
            </div>

            <div id="scheduleRunResult" style="display:none; padding:12px 16px; border-radius:8px; margin-bottom:16px;"></div>

            <% if (schedList.length === 0) { %>
                <div class="admin-empty" style="padding:30px 10px; text-align:center;">
                    <p style="font-size:15px; color:#64748b; margin-bottom:12px;">No tienes ninguna tarea programada todavía.</p>
                    <span style="font-size:13px; color:#94a3b8;">Crea una tarea en el formulario de la izquierda para que el sistema empiece a publicar artículos según las tendencias de Google.</span>
                </div>
            <% } else { %>
                <div style="display:flex; flex-direction:column; gap:12px;">
                    <% schedList.forEach(function(sched) { %>
                        <div style="border:1px solid #e2e8f0; border-radius:8px; padding:14px; background:#f8fafc;">
                            <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px;">
                                <div>
                                    <strong style="font-size:15px; color:#0f172a; text-transform:capitalize;">
                                        <%= (sched.sector_slug || sched.topic || 'General').replace(/-/g, ' ') %>
                                    </strong>
                                    <span style="display:inline-block; background:#e0e7ff; color:#3730a3; font-size:11px; font-weight:700; padding:2px 8px; border-radius:12px; margin-left:6px; text-transform:uppercase;">
                                        📍 <%= sched.provincia_slug || 'madrid' %>
                                    </span>
                                    <span style="display:inline-block; background:#dcfce7; color:#166534; font-size:11px; font-weight:700; padding:2px 8px; border-radius:12px; margin-left:4px;">
                                        ⏱ <%= sched.frequency %>
                                    </span>
                                </div>
                                <span style="font-size:12px; font-weight:700; color:<%= sched.is_active ? '#16a34a' : '#94a3b8' %>;">
                                    <%= sched.is_active ? '● Activa' : '○ Pausada' %>
                                </span>
                            </div>

                            <div style="font-size:12.5px; color:#64748b; margin-bottom:12px;">
                                <span>Modo: <strong><%= sched.use_trends ? '🔥 Tendencias Google' : 'Tema fijo' %></strong></span>
                                <span> · </span>
                                <span>Última ejecución: <strong><%= sched.last_run ? new Date(sched.last_run).toLocaleString('es-ES') : 'Pendiente del primer ciclo' %></strong></span>
                            </div>

                            <div style="display:flex; gap:8px; align-items:center;">
                                <button type="button" class="btn-run-schedule admin-primary-button" data-id="<%= sched.id %>" style="background:#10b981; font-size:12px; padding:6px 12px;">
                                    ⚡ Ejecutar Ahora
                                </button>
                                
                                <form action="/admin/schedules/<%= sched.id %>/toggle" method="POST" style="margin:0;">
                                    <button type="submit" class="admin-primary-button" style="background:#64748b; font-size:12px; padding:6px 12px;">
                                        <%= sched.is_active ? 'Pausar' : 'Activar' %>
                                    </button>
                                </form>

                                <form action="/admin/schedules/<%= sched.id %>/delete" method="POST" style="margin:0;" onsubmit="return confirm('¿Eliminar esta programación?');">
                                    <button type="submit" class="admin-primary-button" style="background:#ef4444; font-size:12px; padding:6px 12px;">
                                        Eliminar
                                    </button>
                                </form>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </section>
    </div>
</main>

<script>
// Manejador del botón "⚡ Ejecutar Ahora" para lanzar el artículo desde tendencias de Google
document.querySelectorAll(".btn-run-schedule").forEach(btn => {
    btn.addEventListener("click", async function() {
        const schedId = this.dataset.id;
        const resultBox = document.getElementById("scheduleRunResult");
        const originalText = this.textContent;

        this.disabled = true;
        this.textContent = "Buscando tendencia y creando...";
        resultBox.style.display = "block";
        resultBox.style.background = "#eff6ff";
        resultBox.style.border = "1px solid #bfdbfe";
        resultBox.style.color = "#1d4ed8";
        resultBox.innerHTML = "⏳ Consultando tendencias en vivo de Google para este sector y provincia...";

        try {
            const res = await fetch(`/admin/schedules/${schedId}/run`, { method: "POST" });
            const data = await res.json();

            if (!data.success) throw new Error(data.error || "Error al ejecutar");

            resultBox.style.background = "#f0fdf4";
            resultBox.style.border = "1px solid #bbf7d0";
            resultBox.style.color = "#166534";
            resultBox.innerHTML = `
                <strong>✔ ¡Artículo creado con éxito desde Google Trends!</strong><br>
                <span>Tendencia detectada: <em>"${data.trendQuery}"</em></span><br>
                <div style="margin-top:6px;">
                    <a href="${data.url}" target="_blank" style="color:#15803d; font-weight:700; text-decoration:underline;">
                        Ver artículo publicado: ${data.title} ↗
                    </a>
                </div>
            `;
        } catch (err) {
            resultBox.style.background = "#fef2f2";
            resultBox.style.border = "1px solid #fecaca";
            resultBox.style.color = "#991b1b";
            resultBox.innerHTML = `<strong>Error:</strong> ${err.message}`;
        } finally {
            this.disabled = false;
            this.textContent = originalText;
        }
    });
});
</script>

    </main>
  </div>

  <%- include("partials/footer") %>
</body>
</html>