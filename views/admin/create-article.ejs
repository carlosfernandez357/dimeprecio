<%- include("partials/header") %>
<%- include("partials/sidebar") %>

<main class="admin-main">
    <link rel="stylesheet" href="/css/admin.css">
    <div class="admin-page-header">
        <div>
            <h1>Crear Artículo con IA (Interconectado con Provincia y Sector)</h1>
            <p>Genera artículos SEO con IA como en SocialsForce. Al elegir la Provincia y el Sector, la página mostrará automáticamente abajo el formulario exclusivo de ese sector y se enlazará con el resto de artículos de esa zona.</p>
        </div>
    </div>
    <script src="https://cdn.tiny.cloud/1/no-api-key/tinymce/6/tinymce.min.js"></script>
    <div class="admin-create-layout">

        <div class="admin-card" style="border: 2px solid #2563eb; background: #ffffff;">

            <div class="admin-card-header" style="background:#eff6ff; margin:-20px -20px 16px -20px; padding:16px 20px; border-bottom:1px solid #bfdbfe; border-radius:8px 8px 0 0;">
                <h2 style="color:#1d4ed8; font-size:17px; margin:0; display:flex; align-items:center; gap:8px;">
                    🔥 Tendencias en Tiempo Real de Google (SEO / AEO)
                </h2>
                <p style="margin:4px 0 0; font-size:12.5px; color:#475569;">
                    Descubre las búsquedas y preguntas exactas que la gente hace ahora mismo en Google España. Pulsa cualquier sugerencia para auto-rellenar y optimizar tu artículo.
                </p>
            </div>

            <div style="background:#f8fafc; padding:12px; border-radius:8px; border:1px solid #e2e8f0; margin-bottom:15px;">
                <div style="display:grid; grid-template-columns: 1fr 1fr; gap:8px; margin-bottom:8px;">
                    <div>
                        <label style="font-size:11.5px; font-weight:700; color:#475569; display:block; margin-bottom:4px;">Servicio a consultar</label>
                        <input type="text" id="trendKeywordInput" placeholder="Ej: fontanero, reformas, aire acondicionado..." style="width:100%; padding:8px 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px;">
                    </div>
                    <div>
                        <label style="font-size:11.5px; font-weight:700; color:#475569; display:block; margin-bottom:4px;">Provincia de búsqueda</label>
                        <select id="trendLocationInput" style="width:100%; padding:8px 10px; border:1px solid #cbd5e1; border-radius:6px; font-size:13px;">
                            <% (allLocations || []).forEach(function(loc) { %>
                                <option value="<%= loc.slug %>" <%= loc.slug === 'madrid' ? 'selected' : '' %>><%= loc.nombre %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <div style="display:flex; gap:8px;">
                    <button type="button" id="btnExploreTrends" class="admin-primary-button" style="background:#2563eb; font-size:13px; padding:8px 14px; flex:1;">
                        🔍 Explorar Búsquedas Reales
                    </button>
                    <button type="button" id="btnExploreDeep" class="admin-primary-button" style="background:#0f172a; font-size:13px; padding:8px 14px;">
                        ⚡ Modo Profundo (A-Z)
                    </button>
                </div>
            </div>

            <div id="trendsBox" style="display:none; margin-bottom:16px;">
                <div style="margin-bottom:12px;">
                    <span style="font-size:12px; font-weight:700; color:#1e293b; display:block; margin-bottom:6px;">💰 Búsquedas con Mayor Intención de Compra y Tarifas:</span>
                    <div id="priceQueriesList" style="display:flex; flex-wrap:wrap; gap:6px;"></div>
                </div>

                <div>
                    <span style="font-size:12px; font-weight:700; color:#1e293b; display:block; margin-bottom:6px;">❓ Preguntas Frecuentes de Usuarios (AEO para IA):</span>
                    <div id="questionQueriesList" style="display:flex; flex-wrap:wrap; gap:6px;"></div>
                </div>
            </div>

            <hr style="border:none; border-top:1px solid #e2e8f0; margin:15px 0;">

            <div class="admin-card-header">
                <h2>AI Generator</h2>
            </div>

            <form id="aiForm">

                <div class="admin-form-group">
                    <label>Tema / Búsqueda del cliente (ej: "Cómo arreglar mi baño en Madrid o hacer una reforma pequeña en casa")</label>
                    <textarea type="text" id="aiPrompt" placeholder="Ej: Guía completa para arreglar un cuarto de baño en Madrid, cambiar bañera por plato de ducha y solucionar humedades..."></textarea>
                </div>

                <button
                    type="submit"
                    class="admin-primary-button"
                    style="background:#10b981;"
                >
                    ✨ Generar Artículo Completo con IA y Tendencias
                </button>

            </form>
            <div class="admin-ai-status" id="aiStatus">
                Waiting...
            </div>
            <button type="button" class="admin-ai-clear" onclick="document.getElementById('aiStatus').innerHTML = ''">
                Clear Console
            </button>
        </div>

        <div class="admin-card">

            <% const isEditing = (typeof post !== 'undefined' && post && post.id); %>
            <div class="admin-card-header">
                <h2><%= isEditing ? ('Editar Artículo #' + post.id + ': ' + post.title) : 'Información del Artículo, Sector, Formulario e Impulso en Algoritmo' %></h2>
            </div>

            <form
                action="<%= isEditing ? ('/admin/edit-article/' + post.id) : '/admin/articles/create' %>"
                method="POST"
            >

                <div class="admin-form-group">
                    <label>Title</label>
                    <input
                        type="text"
                        name="title"
                        id="title"
                        value="<%= isEditing ? (post.title || '') : '' %>"
                        required
                    >
                </div>

                <div class="admin-form-group">
                    <label>Slug</label>
                    <input
                        type="text"
                        name="slug"
                        id="slug"
                        value="<%= isEditing ? (post.slug || '') : '' %>"
                        required
                    >
                </div>

                <div class="admin-form-group" style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
                    <div>
                        <label>Provincia SEO (interconexión local)</label>
                        <select name="provincia_slug" id="provincia_slug" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;">
                            <% (allLocations || []).forEach(function(loc) { %>
                                <option value="<%= loc.slug %>" <%= (isEditing && post.provincia_slug === loc.slug) ? 'selected' : '' %>><%= loc.nombre %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div>
                        <label>Sector (inserta abajo el formulario exclusivo de este sector)</label>
                        <select name="sector_slug" id="sector_slug" onchange="var sel=this.options[this.selectedIndex]; document.getElementById('category').value=sel.text;" style="width:100%;padding:10px;border:1px solid #d1d5db;border-radius:6px;">
                            <% (allSectors || []).forEach(function(sec) { %>
                                <option value="<%= sec.slug %>" <%= (isEditing && post.sector_slug === sec.slug) ? 'selected' : '' %>><%= sec.nombre %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="admin-form-group" style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;background:#f8fafc;padding:12px;border-radius:8px;border:1px solid #e2e8f0;">
                    <label style="display:flex;align-items:center;gap:8px;font-weight:700;cursor:pointer;">
                        <input type="checkbox" name="is_pinned" value="1" <%= (isEditing && post.is_pinned) ? 'checked' : '' %>>
                        📌 Fijar arriba (Pinned)
                    </label>
                    <label style="display:flex;align-items:center;gap:8px;font-weight:700;cursor:pointer;">
                        <input type="checkbox" name="is_selected" value="1" <%= (!isEditing || post.is_selected) ? 'checked' : '' %>>
                        ⭐ Recomendar con algoritmo
                    </label>
                    <div>
                        <label style="font-size:12px;font-weight:700;">Peso en Algoritmo (1-10)</label>
                        <input type="number" name="priority_weight" min="1" max="10" value="<%= isEditing ? (post.priority_weight || 9) : 9 %>" style="width:70px;padding:6px;">
                    </div>
                </div>

                <div class="admin-form-group">
                    <label>Category</label>
                    <input
                        type="text"
                        name="category"
                        id="category"
                        value="<%= isEditing ? (post.category_name || post.category || 'Reformas Integrales y Baños/Cocinas') : 'Reformas Integrales y Baños/Cocinas' %>"
                        required
                    >
                </div>

                <div class="admin-form-group">
                    <label>Tags / Palabras clave SEO</label>
                    <input
                        type="text"
                        name="tags"
                        id="tags"
                        value="<%= isEditing ? (post.keywords || post.tags || '') : '' %>"
                        placeholder="arreglar baño madrid, reforma pequeña casa, cambiar bañera por ducha"
                    >
                    <small>
                        Separa las etiquetas con comas.
                    </small>
                </div>

                <div class="admin-form-group">
                    <label>Topics (recommendations)</label>
                    <input
                        type="text"
                        name="topics"
                        id="topics"
                        value="<%= isEditing ? (post.topics || '') : '' %>"
                        placeholder="reformas baño:9, fontanería:7, humedades:6"
                    >
                    <small>
                        Nombre:peso (1-10), separados por comas.
                    </small>
                </div>

                <div class="admin-form-group">
                    <label>Evergreen (0 = noticia puntual, 10 = guía siempre relevante para SEO)</label>
                    <input type="number" name="evergreen" id="evergreen" min="0" max="10" value="<%= isEditing ? (post.evergreen || 9) : 9 %>">
                </div>

                <div class="admin-form-group">
                    <label>Depth (1 = corto, 10 = guía completa en profundidad)</label>
                    <input type="number" name="depth" id="depth" min="1" max="10" value="<%= isEditing ? (post.depth || 8) : 8 %>">
                </div>

                <div class="admin-form-group">
                    <label>Excerpt (Meta Description SEO)</label>
                    <textarea
                        name="excerpt"
                        id="excerpt"
                        rows="4"
                    ><%= isEditing ? (post.excerpt || '') : '' %></textarea>
                </div>

                <div class="admin-form-group">
                    <label>Featured Image</label>
                    <input
                        type="text"
                        name="image"
                        id="image"
                        value="<%= isEditing ? (post.featured_image || post.image || '') : '' %>"
                        placeholder="https://..."
                    >
                </div>

                <div class="admin-form-group">
                    <label>Content (HTML)</label>
                    <textarea name="content" id="content"><%= isEditing ? (post.content || '') : '' %></textarea>
                </div>

                <button
                    type="submit"
                    class="admin-primary-button"
                    style="background: <%= isEditing ? '#059669' : '#0f172a' %>; font-size:15px; font-weight:700; padding:12px 24px;"
                >
                    <%= isEditing ? '💾 Guardar Cambios del Artículo' : 'Publish Article' %>
                </button>

            </form>

        </div>

    </div>

</main>

<script>
// Manejo de Tendencias de Google en Vivo
(function() {
    const kwInput = document.getElementById("trendKeywordInput");
    const locInput = document.getElementById("trendLocationInput");
    const sectorSelect = document.getElementById("sector_slug");
    const provSelect = document.getElementById("provincia_slug");
    const btnExplore = document.getElementById("btnExploreTrends");
    const btnDeep = document.getElementById("btnExploreDeep");
    const box = document.getElementById("trendsBox");
    const priceList = document.getElementById("priceQueriesList");
    const questionList = document.getElementById("questionQueriesList");

    // Sincronizar selección de provincia y sector
    if (sectorSelect && kwInput) {
        kwInput.value = sectorSelect.options[sectorSelect.selectedIndex]?.text?.split(" ")[0]?.toLowerCase() || "reformas";
        sectorSelect.addEventListener("change", function() {
            kwInput.value = this.options[this.selectedIndex]?.text?.split(" ")[0]?.toLowerCase() || "";
        });
    }

    if (provSelect && locInput) {
        locInput.value = provSelect.value;
        provSelect.addEventListener("change", function() {
            locInput.value = this.value;
        });
        locInput.addEventListener("change", function() {
            provSelect.value = this.value;
        });
    }

    async function loadTrends(isDeep = false) {
        const query = kwInput.value.trim() || "reformas";
        const location = locInput.value || "madrid";

        const originalBtnText = isDeep ? btnDeep.textContent : btnExplore.textContent;
        if (isDeep) { btnDeep.textContent = "Buscando..."; btnDeep.disabled = true; }
        else { btnExplore.textContent = "Buscando..."; btnExplore.disabled = true; }

        try {
            const url = `/api/trends/suggestions?query=${encodeURIComponent(query)}&location=${encodeURIComponent(location)}${isDeep ? '&deep=1' : ''}`;
            const res = await fetch(url);
            const data = await res.json();

            if (!data.success) throw new Error(data.error || "No se pudieron obtener tendencias");

            priceList.innerHTML = "";
            questionList.innerHTML = "";

            const prices = data.priceQueries && data.priceQueries.length ? data.priceQueries : (data.suggestions || []).slice(0, 6);
            const questions = data.questions && data.questions.length ? data.questions : (data.suggestions || []).slice(6, 12);

            function createChip(text, isPrice = true) {
                const badge = document.createElement("button");
                badge.type = "button";
                badge.style.cssText = `background:${isPrice ? '#ecfdf5' : '#eff6ff'}; color:${isPrice ? '#065f46' : '#1e40af'}; border:1px solid ${isPrice ? '#a7f3d0' : '#bfdbfe'}; padding:5px 10px; border-radius:20px; font-size:12px; cursor:pointer; font-weight:600; text-align:left; transition:all 0.15s ease;`;
                badge.innerHTML = (isPrice ? "💵 " : "❓ ") + text;
                badge.title = "Haz clic para rellenar el artículo con esta búsqueda exacta";
                badge.addEventListener("mouseenter", () => badge.style.transform = "scale(1.02)");
                badge.addEventListener("mouseleave", () => badge.style.transform = "scale(1)");
                badge.addEventListener("click", () => {
                    document.getElementById("aiPrompt").value = text;
                    const cap = text.charAt(0).toUpperCase() + text.slice(1);
                    document.getElementById("title").value = `${cap}: Precios y Guía (2026)`;
                    document.getElementById("slug").value = text.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") + "-2026";
                    
                    const tagsField = document.getElementById("tags");
                    const currentTags = tagsField.value ? tagsField.value.split(",").map(t => t.trim()) : [];
                    if (!currentTags.includes(text)) currentTags.push(text);
                    tagsField.value = currentTags.join(", ");

                    // Feedback visual
                    const promptArea = document.getElementById("aiPrompt");
                    promptArea.style.border = "2px solid #10b981";
                    setTimeout(() => promptArea.style.border = "", 1400);
                });
                return badge;
            }

            prices.forEach(p => priceList.appendChild(createChip(p, true)));
            questions.forEach(q => questionList.appendChild(createChip(q, false)));

            if (prices.length === 0 && questions.length === 0) {
                priceList.innerHTML = `<span style="font-size:12px; color:#64748b;">No se encontraron sugerencias directas para "${query}". Prueba con otra palabra clave.</span>`;
            }

            box.style.display = "block";
        } catch (err) {
            alert("Error buscando tendencias: " + err.message);
        } finally {
            if (isDeep) { btnDeep.textContent = originalBtnText; btnDeep.disabled = false; }
            else { btnExplore.textContent = originalBtnText; btnExplore.disabled = false; }
        }
    }

    if (btnExplore) btnExplore.addEventListener("click", () => loadTrends(false));
    if (btnDeep) btnDeep.addEventListener("click", () => loadTrends(true));
})();

document.getElementById("aiForm").addEventListener("submit", async e => {
    e.preventDefault();

    const prompt = document.getElementById("aiPrompt").value;
    const button = e.target.querySelector("button");
    const status = document.getElementById("aiStatus");

    function log(message) {
        const time = new Date().toLocaleTimeString();
        status.textContent += `\n[${time}] ${message}`;
        status.scrollTop = status.scrollHeight;
    }

    status.textContent = "";
    log("Iniciando generación de artículo optimizado para SEO / AEO...");
    log(`Tema / Búsqueda: "${prompt}"`);

    button.disabled = true;
    button.textContent = "Generando artículo...";

    try {
        log("Enviando solicitud al motor generador...");
        const response = await fetch("/createArticle", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                prompt,
                category: document.getElementById("category").value,
                provincia_slug: document.getElementById("provincia_slug").value,
                sector_slug: document.getElementById("sector_slug").value
            })
        });

        log(`Respuesta recibida: HTTP ${response.status}`);
        if (!response.ok) {
            throw new Error(`El servidor devolvió HTTP ${response.status}`);
        }

        const article = await response.json();
        if (!article.success) {
            throw new Error(article.error || "No se pudo generar el artículo");
        }

        log("¡Artículo generado y optimizado con éxito!");
        document.getElementById("title").value = article.title || "";
        document.getElementById("slug").value = article.slug || "";
        document.getElementById("excerpt").value = article.excerpt || "";
        document.getElementById("category").value = article.category || document.getElementById("category").value;
        document.getElementById("image").value = article.image || "";
        document.getElementById("tags").value = Array.isArray(article.tags) ? article.tags.join(", ") : (article.tags || "");
        
        if (document.getElementById("topics")) {
            document.getElementById("topics").value = article.topicsString || (Array.isArray(article.topics) ? article.topics.map(t => typeof t === 'object' ? `${t.name}:${t.weight}` : t).join(", ") : "");
        }
        if (document.getElementById("evergreen") && article.evergreen) {
            document.getElementById("evergreen").value = article.evergreen;
        }
        if (document.getElementById("depth") && article.depth) {
            document.getElementById("depth").value = article.depth;
        }

        const editor = tinymce.get("content");
        if (editor) {
            editor.setContent(article.content || "");
        } else {
            document.getElementById("content").value = article.content || "";
        }

        log("Formulario completado. Puedes revisar y pulsar 'Publish Article'.");
    } catch (err) {
        log(`ERROR: ${err.message}`);
    } finally {
        button.disabled = false;
        button.textContent = "✨ Generar Artículo Completo con IA y Tendencias";
    }
});

tinymce.init({
    selector: "#content",
    height: 600,
    menubar: true,
    plugins: ["lists", "link", "image", "table", "code", "fullscreen", "preview"],
    toolbar: "undo redo | styles | bold italic underline | alignleft aligncenter alignright | bullist numlist | link image table | code fullscreen preview"
});

// Auto-rellenar desde Search Console si viene ?topic=...
(function() {
    var params = new URLSearchParams(window.location.search);
    var topic = params.get("topic");
    if (topic) {
        var aiPrompt = document.getElementById("aiPrompt");
        if (aiPrompt) {
            aiPrompt.value = topic;
            aiPrompt.style.border = "2px solid #3b82f6";
        }
        var title = document.getElementById("title");
        if (title && !title.value) {
            var cap = topic.charAt(0).toUpperCase() + topic.slice(1);
            title.value = cap + ": Precios y Guía (2026)";
        }
        var slug = document.getElementById("slug");
        if (slug && !slug.value) {
            slug.value = topic.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "") + "-2026";
        }
    }
})();
</script>

<%- include("partials/footer") %>
