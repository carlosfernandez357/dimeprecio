<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Clientes Captados (Formularios por Sector) — DimePrecio.es</title>
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body>
  <%- include("partials/header") %>

  <div class="admin-layout">
    <%- include("partials/sidebar") %>

    <main class="admin-main" style="padding:28px;">
      <div style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;margin-bottom:24px;">
        <div>
          <h1 style="margin:0 0 6px;font-size:26px;color:#0f172a;">📥 Clientes Captados desde los Formularios de cada Sector</h1>
          <p style="margin:0;color:#475569;font-size:14.5px;">
            Aquí llegan directamente todos los clientes que han encontrado un artículo o página de sector (ej. <em>"arreglar mi baño en Madrid"</em>) y han rellenado el formulario inferior con su teléfono, respuestas y archivos adjuntos.
          </p>
        </div>

        <form method="GET" action="/admin/presupuestos" style="display:flex;gap:8px;flex-wrap:wrap;">
          <select name="provincia" style="padding:9px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;">
            <option value="">Todas las provincias</option>
            <% (allLocations || []).forEach(function(loc) { %>
              <option value="<%= loc.slug %>" <%= filters.provincia_slug === loc.slug ? 'selected' : '' %>><%= loc.nombre %></option>
            <% }); %>
          </select>
          <select name="sector" style="padding:9px 12px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;">
            <option value="">Todos los sectores</option>
            <% (allSectors || []).forEach(function(sec) { %>
              <option value="<%= sec.slug %>" <%= filters.sector_slug === sec.slug ? 'selected' : '' %>><%= sec.nombre %></option>
            <% }); %>
          </select>
          <button type="submit" style="background:#0f172a;color:#fff;border:none;padding:9px 16px;border-radius:8px;font-weight:700;cursor:pointer;">Filtrar</button>
        </form>
      </div>

      <% if (!quotes || quotes.length === 0) { %>
        <div style="background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:30px;text-align:center;color:#64748b;">
          No hay solicitudes para los filtros seleccionados.
        </div>
      <% } %>

      <% (quotes || []).forEach(function(q) { %>
        <div id="quote-<%= q.id %>" style="background:#fff;border:1px solid #cbd5e1;border-radius:16px;padding:24px;margin-bottom:20px;box-shadow:0 4px 15px rgba(15,23,42,0.04);">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:14px;padding-bottom:14px;border-bottom:1px solid #e2e8f0;">
            <div>
              <span style="background:#0f172a;color:#fff;font-weight:800;font-size:12px;padding:4px 10px;border-radius:6px;"><%= q.codigo %></span>
              <span style="background:#dbeafe;color:#1d4ed8;font-weight:800;font-size:12px;padding:4px 10px;border-radius:6px;margin-left:6px;">
                📍 <%= q.provincia_nombre %> · <%= q.municipio %>
              </span>
              <span style="background:#f1f5f9;color:#334155;font-weight:700;font-size:12px;padding:4px 10px;border-radius:6px;margin-left:6px;">
                🛠️ <%= q.sector_nombre %>
              </span>
              <h2 style="margin:10px 0 4px;font-size:20px;color:#0f172a;">
                Cliente: <%= q.nombre_cliente %> —
                <a href="tel:<%= q.telefono_whatsapp %>" style="color:#15803d;text-decoration:none;">📞 <%= q.telefono_whatsapp %></a>
                ·
                <a href="https://wa.me/34<%= String(q.telefono_whatsapp || '').replace(/[^0-9]/g, '') %>" target="_blank" style="color:#15803d;font-size:14px;text-decoration:underline;">Abrir WhatsApp ↗</a>
              </h2>
              <div style="font-size:12.5px;color:#64748b;">
                Recibido: <%= new Date(q.created_at).toLocaleString('es-ES') %> · Página desde la que envió el formulario: <strong><%= q.origen_titulo %></strong>
              </div>
            </div>

            <form method="POST" action="/admin/presupuestos/<%= q.id %>/actualizar" style="display:flex;gap:8px;align-items:center;">
              <select name="estado_agente" style="padding:8px 10px;border:1px solid #cbd5e1;border-radius:8px;font-size:12.5px;font-weight:700;">
                <option value="nuevo_en_bandeja" <%= q.estado_agente === 'nuevo_en_bandeja' ? 'selected' : '' %>>🔴 Pendiente de contactar</option>
                <option value="enviado_profesional" <%= q.estado_agente === 'enviado_profesional' ? 'selected' : '' %>>🟡 En gestión</option>
                <option value="desbloqueado_pagado" <%= q.estado_agente === 'desbloqueado_pagado' ? 'selected' : '' %>>🟢 Atendido / Cerrado</option>
              </select>
              <button type="submit" style="background:#0f172a;color:#fff;border:none;padding:8px 14px;border-radius:8px;font-weight:700;font-size:12.5px;cursor:pointer;">
                Guardar Estado
              </button>
            </form>
          </div>

          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:18px;margin-top:16px;">
            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:16px;">
              <h3 style="margin:0 0 8px;font-size:14px;color:#0f172a;">📝 Explicación escrita por el cliente</h3>
              <p style="margin:0 0 14px;font-size:14px;color:#1e293b;line-height:1.55;background:#fff;padding:12px;border-radius:8px;border:1px solid #cbd5e1;">
                "<%= q.explicacion_cliente %>"
              </p>

              <h4 style="margin:0 0 8px;font-size:12.5px;color:#475569;text-transform:uppercase;">Respuestas al formulario de <%= q.sector_nombre %>:</h4>
              <ul style="margin:0;padding-left:18px;font-size:13px;color:#334155;line-height:1.6;">
                <% Object.entries(q.campos_formulario_json || {}).forEach(function([k, val]) { %>
                  <li><strong><%= k.replace(/_/g, ' ') %>:</strong> <%= val %></li>
                <% }); %>
              </ul>

              <% if (q.archivos_adjuntos && q.archivos_adjuntos.length > 0) { %>
                <div style="margin-top:14px;padding-top:12px;border-top:1px dashed #cbd5e1;">
                  <strong style="font-size:12.5px;color:#1d4ed8;display:block;margin-bottom:6px;">📎 Archivos / Fotos subidos por el cliente:</strong>
                  <% q.archivos_adjuntos.forEach(function(file) { %>
                    <a href="/admin/archivos/forms/<%= encodeURIComponent(file.filename) %>" download style="display:inline-block;background:#dbeafe;color:#1e40af;padding:6px 12px;border-radius:6px;text-decoration:none;font-size:12.5px;font-weight:700;margin-right:6px;">
                      📥 Descargar <%= file.originalName || file.filename %>
                    </a>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:12px;padding:16px;">
              <form method="POST" action="/admin/presupuestos/<%= q.id %>/actualizar" style="display:grid;gap:10px;">
                <label style="font-size:13px;font-weight:700;color:#0f172a;">Tus notas privadas sobre este cliente:</label>
                <textarea name="notas_agente" rows="5" placeholder="Anota aquí con qué profesional has hablado o cualquier seguimiento..." style="width:100%;padding:10px;border:1px solid #cbd5e1;border-radius:8px;font-size:13px;font-family:inherit;"><%= q.notas_agente || '' %></textarea>
                <button type="submit" style="justify-self:start;background:#2563eb;color:#fff;border:none;padding:9px 16px;border-radius:8px;font-weight:700;font-size:13px;cursor:pointer;">
                  Guardar Notas
                </button>
              </form>
            </div>
          </div>
        </div>
      <% }); %>
    </main>
  </div>
</body>
</html>
